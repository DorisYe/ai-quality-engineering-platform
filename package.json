{
  "name": "ai-quality-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven quality engineering practice application",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "check": "node --check backend/server.js && node --check backend/database.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "portal": "node portal/server.js",
    "test:unit": "node --test",
    "test:core": "playwright test --grep \"TC-00[1-5]:\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}
